# GitSentry Environment Variables
# In production on Cloud Run, secrets are fetched from Google Secret Manager.
# For local testing, you can provide environment variables here.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Cloud Platform
GCP_PROJECT_ID=my-gcp-project-id
PUBSUB_TOPIC_PR_EVENTS=pr-events

# Secret Manager Secret Resource Names (or local direct values in development)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GEMINI_API_KEY=your_gemini_api_key_here

# Secret Manager Secret IDs (when loading directly from Secret Manager)
GITHUB_WEBHOOK_SECRET_NAME=github-webhook-secret
GITHUB_APP_PRIVATE_KEY_NAME=github-app-private-key
GEMINI_API_KEY_NAME=gemini-api-key

# Service Ports
PORT=8000
HOST=0.0.0.0
